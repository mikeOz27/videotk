# Copia este archivo como .env y cambia lo que necesites. En un hosting (Render, Railway, Fly…)
# pon estas mismas variables en su panel de "Environment" en vez de subir el .env.

PORT=3000

# ---------- Base de datos: elige una ----------
# sqlite   → un archivo en data/ (lo más simple; para tu PC o un VPS con disco propio)
# postgres → Neon, Supabase (solo como base), Render, Railway… DATABASE_URL=postgres://usuario:clave@host:5432/base
# mysql    → Laragon/XAMPP, hostings con MySQL…              DATABASE_URL=mysql://usuario:clave@host:3306/base
DB_CLIENT=sqlite
# DATABASE_URL=
# DB_SSL=true            # la mayoría de bases en la nube lo piden
# SQLITE_FILE=data/videotk.db

# Clave para firmar las sesiones (mínimo 32 caracteres, que nadie la conozca).
# Si no la pones se crea una en data/jwt-secret; en hostings con disco temporal ponla siempre.
# JWT_SECRET=

# Dirección pública de este servidor (para los enlaces de los correos). Si no, se deduce de la petición.
# PUBLIC_URL=https://videotk-api.onrender.com
# Detrás de un proxy (Render, Railway, Nginx…) ponlo en 1.
# TRUST_PROXY=1

# Webs a las que pueden volver los enlaces de los correos (la primera es la de por defecto).
SITE_URLS=https://mikeoz27.github.io/videotk/
# Webs y apps que pueden usar la API (la app Android es https://localhost; la de iOS, capacitor://localhost).
CORS_ORIGINS=https://mikeoz27.github.io,https://localhost,capacitor://localhost

# Entregar también la web desde este servidor (http://localhost:3000).
SERVE_WEB=true

# ---------- Correo (códigos, recuperar contraseña, confirmar cuenta) ----------
# Sin SMTP los correos salen en la consola del servidor (útil para probar).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=VideoTk <no-reply@tudominio.com>
# Pedir confirmar el correo al registrarse (por defecto: sí si hay SMTP, no si no lo hay).
# EMAIL_CONFIRM=true
# ALLOW_SIGNUP=true
